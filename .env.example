# --- Required ---------------------------------------------------------
# xAI Grok API key (https://console.x.ai). The only LLM the application uses.
GROK_API_KEY=
# Grok model id, e.g. grok-4
GROK_MODEL=grok-4
# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL=postgres://research:research@localhost:5432/research
# Tavily search API key (https://tavily.com)
SEARCH_API_KEY=

# --- Optional ---------------------------------------------------------
BIND_ADDR=0.0.0.0:8080
GROK_BASE_URL=https://api.x.ai/v1
CORS_ORIGIN=http://localhost:3000
RUST_LOG=info,deep_research_os_backend=debug

# Cost / concurrency limits (defaults shown)
MAX_ITERATIONS=2
MAX_TASKS_PER_ITERATION=6
MAX_CONCURRENT_TASKS=3
MAX_CONCURRENT_LLM_CALLS=4
MAX_CONCURRENT_RUNS=2
SOURCES_PER_TASK=4
TASK_TIMEOUT_SECS=240
LLM_TIMEOUT_SECS=120
HTTP_TIMEOUT_SECS=20
